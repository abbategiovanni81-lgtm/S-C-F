# SocialCommand - environment variables
# Per the BYOK decision (PLAN.md 4.1b): AI provider keys (KIE, fal,
# OpenRouter, ElevenLabs, Gemini, Apify) are per-user, entered in Settings,
# encrypted at rest. They are NEVER env vars. This file is infrastructure only.

# --- Required ---
# Postgres connection string. Server crashes at boot without it (server/db.ts).
DATABASE_URL=postgresql://user:password@host:5432/socialcommand

# Express session signing secret. REQUIRED in production - no fallback.
SESSION_SECRET=

# Master key for encrypting user-supplied API keys at rest (AES-256-GCM).
# Generate: openssl rand -base64 32
KEY_ENCRYPTION_MASTER=

# --- Scheduler (NO always-on loop by default - Replit cost protection) ---
# Zernio + YouTube posts schedule natively on the platform. Direct-platform
# scheduled posts fire when an external cron POSTs /api/scheduler/tick with
# header X-Cron-Secret: $CRON_SECRET. Only set SCHEDULER_MODE=interval on
# always-on hosts (VPS) where a background loop costs nothing extra.
CRON_SECRET=
# SCHEDULER_MODE=interval

# --- Billing (Stripe) ---
# On Replit these are provided by the Replit connector; set explicitly when
# self-hosting (PLAN.md 6.1).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Social platform OAuth apps (direct-routed platforms only) ---
# Direct routing per PLAN.md Phase 3.0: YouTube (Google), Reddit, Pinterest,
# LinkedIn, Bluesky (app password - per user, not env).
# X/IG/FB/TikTok/Threads route via Zernio (user's own key, in Settings).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Legacy (pre-BYOK code paths; removed as Phase 4 lands) ---
# AI_INTEGRATIONS_OPENAI_API_KEY=
# ELEVENLABS_API_KEY=
# APIFY_API_TOKEN=
